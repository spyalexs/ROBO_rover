<?xml version="1.0"?>
<robot name="deepracer_simple">

  <!-- Simple rectangular body centered at base_link -->
  <link name="base_link">
    <visual>
      <origin xyz="0.00 0.00 0.05" rpy="0 0 0"/>
      <geometry>
        <!-- Length, width, height (meters) -->
        <box size="0.32 0.20 0.10"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.4 0.9 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.00 0.00 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.32 0.20 0.10"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.00 0.00 0.05" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.01" ixy="0.0" ixz="0.0"
        iyy="0.02" iyz="0.0"
        izz="0.02"/>
    </inertial>
  </link>

  <!-- Your lidar frame, matching your existing static transform -->
  <link name="laser"/>

  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="-0.0251 0.0 0.1683" rpy="0 0 0"/>
  </joint>

</robot>